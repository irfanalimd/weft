{
  "name": "Weft",
  "short_name": "Weft",
  "description": "Your notes, saved to your own server. Offline-first Markdown that syncs live across your devices.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfbfa",
